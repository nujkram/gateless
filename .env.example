# ── required everywhere ────────────────────────────────────────────────────

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# The Gateless server ID. Enable Developer Mode in Discord, right-click the
# server icon -> Copy Server ID.
GUILD_ID=


# ── required on Vercel only ────────────────────────────────────────────────

# Developer Portal -> your app -> General Information -> Public Key.
# This is what proves a request really came from Discord. Without it the
# endpoint refuses everything.
DISCORD_PUBLIC_KEY=

# Storage. Vercel's filesystem is ephemeral, so the roster cannot live in a
# file there. Add Upstash Redis from the Vercel marketplace and these are set
# for you (as KV_REST_API_URL / KV_REST_API_TOKEN, which are also accepted).
# Leave both blank locally and the roster falls back to data/roster.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
